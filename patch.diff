+        return self.scatter_info is not None and self.scatter_info.total_staged_bytes > 0
+
+    @property
+    def block_tensors(self) -> List[torch.Tensor]:
+        return self._block_tensors
+
+    def cancel(self):
+        self.h2d_stream.synchronize()
+        self.scatter_info = None
+        self._block_tensors = []
